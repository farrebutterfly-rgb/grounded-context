{
  "name": "grounded-context",
  "version": "0.1.0",
  "private": true,
  "description": "Document question answering with verified citations, and a measured comparison of three context strategies for long dialogues.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "answer": "tsx src/cli/answer.ts",
    "source": "tsx src/cli/source.ts",
    "demo": "tsx src/cli/demo.ts",
    "eval": "tsx src/cli/eval.ts",
    "live": "tsx src/cli/answer.ts --live",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
